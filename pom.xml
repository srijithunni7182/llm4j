<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.srijithunni7182</groupId>
    <artifactId>llm4j-parent</artifactId>
    <version>6.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>llm4j Parent</name>
    <description>Parent of the llm4j libraries: shared build, test and release configuration.</description>
    <url>https://github.com/srijithunni7182/llm4j</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>srijithunni7182</id>
            <name>Srijith Unni</name>
            <email>srijithunni7182@gmail.com</email>
            <url>https://github.com/srijithunni7182</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/srijithunni7182/llm4j.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/srijithunni7182/llm4j.git</developerConnection>
        <url>https://github.com/srijithunni7182/llm4j</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/srijithunni7182/llm4j/issues</url>
    </issueManagement>

    <!-- The libraries published to Maven Central. Everything else (engram, the example applications) is built only with -Pextended. src/release/bundle-cleanup must stay LAST: see docs/PUBLISHING.md. -->
    <modules>
        <module>src/ai-agent4j</module>
        <module>src/ai-agent4j-addons</module>
        <module>src/ai-agent4j-tools</module>
        <module>src/eval4j</module>
        <module>src/eval4j-report</module>
        <module>src/loom/ai-agent4j-loom</module>
        <module>src/loom/loom-inspect-core</module>
        <module>src/loom/loom-inspect</module>
        <module>src/loom/loom-fabric</module>
        <module>src/loom/loom-maven-plugin</module>
        <module>src/spring/llm4j-spring-boot-starter</module>
        <module>src/release/bundle-cleanup</module>
    </modules>

    <properties>
        <!-- What every jar says it is (see BuildIdentity). The git properties are replaced by the
             git-commit-id plugin when the build runs in a checkout; "unknown" otherwise. A release
             build (-Prelease) says "release". -->
        <llm4j.build.kind>development</llm4j.build.kind>
        <!-- The last published release: what the JBang catalogue, generated projects and the docs name
             while main carries the next -SNAPSHOT version. The release step changes it with the version. -->
        <llm4j.released>6.1.0</llm4j.released>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!--
            Which tests run. The default build runs only fast, hermetic tests. A test is tagged with JUnit 5 @Tag:
              integration  needs something outside the JVM (a database, a local model server) or exercises several modules end to end
              fragile      depends on wall-clock time, an external program (git, javac, node), the operating system or the checkout's layout
              live         calls a real provider API with a real key (and costs money)
            -Pextended runs integration and fragile too (and builds engram and the examples); -Plive runs only the live ones.
        -->
        <test.groups></test.groups>
        <test.excluded>live,integration,fragile</test.excluded>

        <!-- one Jackson for every module, so a project that uses several gets one version -->
        <jackson.version>2.22.3</jackson.version>

        <!-- -DskipTests also skips the coverage report and rules (they have no test data to check) -->
        <skipTests>false</skipTests>
        <jacoco.skip>${skipTests}</jacoco.skip>

        <!-- false: a release is uploaded and left for you to review in the Central Portal; pass -Dcentral.autoPublish=true to publish at once -->
        <central.autoPublish>false</central.autoPublish>

    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.12.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <groups>${test.groups}</groups>
                        <excludedGroups>${test.excluded}</excludedGroups>
                        <systemPropertyVariables>
                            <user.language>en</user.language>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <doclint>none</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Implementation-Version>${project.version}</Implementation-Version>
                                <Build-Commit>${git.commit.id.abbrev}</Build-Commit>
                                <Build-Dirty>${git.dirty}</Build-Dirty>
                                <Build-Kind>${llm4j.build.kind}</Build-Kind>
                                <Build-Time>${maven.build.timestamp}</Build-Time>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <version>9.0.1</version>
                    <configuration>
                        <failOnNoGitDirectory>false</failOnNoGitDirectory>
                        <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                        <generateGitPropertiesFile>false</generateGitPropertiesFile>
                        <abbrevLength>8</abbrevLength>
                        <skipPoms>false</skipPoms>
                    </configuration>
                </plugin>
                <!-- Run on demand: mvn spotless:check, mvn dependency-check:check -DnvdApiKey=... -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>2.43.0</version>
                    <configuration>
                        <java>
                            <!-- these tests are compared character for character with the wiki page that shows their samples -->
                            <excludes>
                                <exclude>**/*Docs*Test.java</exclude>
                            </excludes>
                            <googleJavaFormat>
                                <version>1.17.0</version>
                                <style>AOSP</style>
                            </googleJavaFormat>
                        </java>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>9.0.9</version>
                    <configuration>
                        <nvdApiKey>${nvdApiKey}</nvdApiKey>
                        <nvdApiDelay>8000</nvdApiDelay>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Which commit a jar was built from, for BuildIdentity and the jar manifest. -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-identity</id>
                        <phase>initialize</phase>
                        <goals><goal>revision</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <!-- Coverage report in target/site/jacoco after the tests. A module that wants a minimum adds its own check execution. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- mvn -Pextended verify: the slow and environment-dependent tests too, and engram and the example applications -->
            <id>extended</id>
            <properties>
                <test.excluded>live</test.excluded>
            </properties>
            <modules>
                <module>src/engram</module>
                <module>src/examples/hexamind-hub</module>
                <module>src/examples/nirmaan-yantra/nirmaan-yantra-server</module>
                <module>src/examples/kingini</module>
                <module>src/examples/gmail-mcp-app</module>
                <module>src/examples/getviral</module>
            </modules>
        </profile>

        <profile>
            <!-- mvn -Plive verify: only the live tests, against real provider APIs, for whichever keys are set -->
            <id>live</id>
            <properties>
                <test.groups>live</test.groups>
                <test.excluded></test.excluded>
            </properties>
        </profile>

        <profile>
            <!--
                mvn -Prelease verify    : builds the sources and javadoc jars and signs everything (add -Dgpg.skip=true to check without a key)
                mvn -Prelease deploy    : uploads one bundle of every module to the Central Portal
                The tests are NOT skipped: a release is gated on the default (hermetic) tests.
            -->
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <!-- the passphrase comes from the MAVEN_GPG_PASSPHRASE environment variable -->
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The Central bundle is zipped from target/central-staging in the last module of the reactor. On the CI runner Maven leaves bookkeeping files there that the
                         Portal rejects: maven-metadata-local.xml in every artifact folder and _remote.repositories (with checksums) in every version folder. Each module stages its
                         own files in its deploy phase, so they are removed in the last module (src/release/bundle-cleanup), after all of them, and before the bundle is built. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>strip-bookkeeping-files-from-bundle</id>
                                <phase>deploy</phase>
                                <goals><goal>clean</goal></goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${maven.multiModuleProjectDirectory}/target/central-staging</directory>
                                            <includes>
                                                <include>**/maven-metadata-local.xml</include>
                                                <include>**/_remote.repositories*</include>
                                            </includes>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
