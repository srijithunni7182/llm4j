// Canonical CTK test: intervention_steer
// A steer corrects the agent's reasoning and never changes the workflow: the same steps run, the agent reads the message.
// Interventions are scripted, not timed: see interventions/intervention_steer.json (README, "Interventions").

agent Collector { model: "ctk" system: "You are Collector." }
agent Writer { model: "ctk" system: "You are Writer." tools: [calculator] steerable: true }
agent Closer { model: "ctk" system: "You are Closer." }

workflow main() {
    delegate "write" to Writer -> out_text
    delegate "close" to Closer -> done_text
}
