// Canonical CTK test: intervention_sibling_discard
// A step stopped because a sibling decided the outcome is dropped: no value, no failure.
// Interventions are scripted, not timed: see interventions/intervention_sibling_discard.json (README, "Interventions").

agent Collector { model: "ctk" system: "You are Collector." }
agent Writer { model: "ctk" system: "You are Writer." tools: [calculator] steerable: true }
agent Closer { model: "ctk" system: "You are Closer." }

workflow main() {
    delegate "write" to Writer -> out_text
    delegate "close" to Closer -> done_text
}
