// Canonical CTK test: intervention_user_cancel_ask
// A person cancels an agent and names no outcome: the run asks, and carries on with the answer.
// Interventions are scripted, not timed: see interventions/intervention_user_cancel_ask.json (README, "Interventions").

agent Collector { model: "ctk" system: "You are Collector." }
agent Writer { model: "ctk" system: "You are Writer." tools: [calculator] steerable: true }
agent Closer { model: "ctk" system: "You are Closer." }

workflow main() {
    delegate "write" to Writer -> out_text
    delegate "close" to Closer -> done_text
}
