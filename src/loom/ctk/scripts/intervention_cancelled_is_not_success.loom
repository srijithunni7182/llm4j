// Canonical CTK test: intervention_cancelled_is_not_success
// A cancelled step is never recorded as a success, whatever the agent had said.
// Interventions are scripted, not timed: see interventions/intervention_cancelled_is_not_success.json (README, "Interventions").

agent Collector { model: "ctk" system: "You are Collector." }
agent Writer { model: "ctk" system: "You are Writer." tools: [calculator] steerable: true }
agent Closer { model: "ctk" system: "You are Closer." }

workflow main() {
    delegate "write" to Writer -> out_text
    on_stopped { skip }
    delegate "close" to Closer -> done_text
}
