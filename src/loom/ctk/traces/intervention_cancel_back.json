{
  "scriptName": "intervention_cancel_back.loom",
  "workflowName": "main",
  "steps": [
    {
      "kind": "delegate",
      "agentName": "Collector",
      "outputVariable": "data"
    },
    {
      "kind": "delegate",
      "agentName": "Writer",
      "outputVariable": "out_text"
    },
    {
      "kind": "stop",
      "agentName": "Writer",
      "payload": "{\"kind\":\"cancel\",\"outcome\":\"REWIND\",\"reason\":\"user\"}"
    },
    {
      "kind": "rewind",
      "payload": "{\"checkpoint\":\"collected\",\"generation\":2}"
    },
    {
      "kind": "delegate",
      "agentName": "Collector",
      "outputVariable": "data"
    },
    {
      "kind": "delegate",
      "agentName": "Writer",
      "outputVariable": "out_text"
    },
    {
      "kind": "delegate",
      "agentName": "Closer",
      "outputVariable": "done_text"
    }
  ]
}
