{
  "scriptName": "intervention_supervise_looping.loom",
  "workflowName": "main",
  "steps": [
    {
      "kind": "delegate",
      "agentName": "Writer",
      "outputVariable": "out_text"
    },
    {
      "kind": "steer",
      "agentName": "Writer",
      "payload": "You are repeating yourself. Try something else."
    },
    {
      "kind": "delegate",
      "agentName": "Closer",
      "outputVariable": "done_text"
    }
  ]
}
