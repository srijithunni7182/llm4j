tool Mail { use: webhook  url: env.HOOK_URL }
agent Summarizer { model: "m"  system: "Summarize." }
agent Mailer { model: "m"  system: "Send." tools: [Mail] }
workflow Main(text) {
  delegate "Summarize {text}" to Summarizer -> summary
  delegate "Tell the team about {text}" to Mailer -> sent
  note "{summary} {sent}"
}
