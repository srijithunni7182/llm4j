tool Files { use: file  root: "data"  mode: read }
agent Analyst {
  model: "m"
  system: "You analyse the request."
  tools: [Files]
  output_schema: { summary: string, risks: list<{ name: string, level: number }> }
}
workflow Main(q) {
  delegate "Look at {q}" to Analyst -> report
  note "{report.summary}"
}
