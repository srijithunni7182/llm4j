schedule Morning { cron: "0 7 * * *"  run: Main(topic = "news") }

evaluator Compliance { model: "gemini-2.5-flash" }
policy HouseRules: "house-rules" checked by Compliance
agent Writer { model: "gemini-2.5-flash" system: "You write the daily note." }

workflow Main(topic) {
    delegate "Write a note about {topic}" to Writer -> note_text
    check note_text against HouseRules using Compliance
    return note_text
}
