agent First { model: "m"  system: "You are a support assistant for our company. Answer politely, keep replies under one hundred words, never promise a refund, and always end by asking whether the customer needs anything else today." }
agent Second { model: "m"  system: "You are a support assistant for our company. Answer politely, keep replies under one hundred words, never promise a refund, and always end by asking whether the customer needs anything else this week." } // <- LP06
workflow Main(q) {
  delegate "{q}" to First -> a
  delegate "{q}" to Second -> b
  note "{a}{b}"
}
