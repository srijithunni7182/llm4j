tool Hook { use: webhook  url: env.HOOK_URL }
agent Notifier { model: "m"  system: "You tell the team what happened."  tools: [Hook]  guard { pii: mask } }
workflow Main(q) {
  delegate "Tell the team: {q}" to Notifier -> sent retry 2 backoff 2s timeout 60s on_failure {
    note "notice failed"
  }
  note "{sent}"
}
// ignore: LP02 LP05 LO01
