agent Writer { model: "m"  system: "You write the daily digest." }
workflow Daily(topic) {
  delegate "Digest of {topic}" to Writer -> digest
  human_prompt "Publish this? {digest}" -> ok // <- LR04
  note "{ok}"
}
schedule Morning { cron: "0 7 * * *"  run: Daily(topic = "news") } // expect-script: LR08
// ignore: LP02 LP05 LO01
