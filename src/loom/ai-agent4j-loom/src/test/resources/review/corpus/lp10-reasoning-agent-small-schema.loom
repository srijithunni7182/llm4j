tool Files { use: file  root: "data"  mode: read }
agent Analyst { model: "m"  system: "You analyse the request."  tools: [Files]  output_schema: { verdict: string, score: number } }
workflow Main(q) {
  delegate "Look at {q}" to Analyst -> report retry 1 timeout 30s
  note "{report.verdict}"
}
// ignore: LP02 LP05 LO01 LC02 LA02 LR01 LP09
