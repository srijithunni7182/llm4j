tool Files { use: file  root: "data"  mode: read }
agent Reader { model: "m"  system: "Extract the invoice fields from the text."  tools: [Files]  output_schema: { vendor: string, total: number } }
workflow Main(text) {
  delegate "Extract the invoice from: {text}" to Reader -> invoice
  note "{invoice.vendor}"
}
// ignore: LP02 LP05 LO01 LC02 LA02 LR01
