schedule Morning { cron: "0 7 * * *"  run: Main(topic = "news") }
tool Notify { use: webhook  url: env.SLACK_WEBHOOK  format: slack  effect: changes }
agent Publisher { model: "m"  system: "Publish."  tools: [Notify]  approve: [Notify] } // <- LH05
workflow Main(topic) {
  delegate "Announce {topic}" to Publisher -> done retry 1 timeout 30s
}
// ignore: LP02 LP05 LO01 LR04 LD01 LR08 LA02 LY07 LB01 LR02
