<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.srijithunni7182</groupId>
        <artifactId>llm4j-parent</artifactId>
        <version>5.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>ai-agent4j-loom</artifactId>
    <packaging>jar</packaging>

    <name>AI Agent4J Loom</name>
    <description>Lexer, Parser, and Compiler for the Loom Agent Orchestration DSL.</description>

    <properties>
        <junit.version>5.10.2</junit.version>
        <!-- One Jackson version for every Jackson artifact, the same as the other modules: a YAML parser from one release beside a core from
             another fails at run time with NoSuchMethodError, and weave reads YAML (prompt front matter, datasets). -->
        <jackson.version>2.21.3</jackson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Core ai-agent4j dependency -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j-addons</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The tools a script can declare: webhook, email, http, file, shell, sql -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j-tools</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The JDBC driver of the sql tool. Optional, so the library does not push it onto anyone; the runnable weave jar (the cli classifier) includes it. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.12</version>
            <optional>true</optional>
        </dependency>

        <!-- JSON Processing (Jackson) from Core -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Golden datasets, judges and scenarios for `weave eval` -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>eval4j</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>5.3.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <!-- Tests the JDBC run journal against a real SQL database. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>

        <!-- SMTP for the `email` tool; optional in ai-agent4j-tools, so the CLI brings it. Only loaded when a script uses it. -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <version>2.0.3</version>
        </dependency>
        <!-- A real SMTP server for testing the `email` tool kind -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>2.1.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Contract test: the graph JSON is validated against its published schema -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.6</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.16</version>
            <!-- Optional, so it is in the weave jar (no "no SLF4J provider" warnings on a command line) but not forced on a project that uses Loom as a library -->
            <optional>true</optional>
        </dependency>

        <!-- CLI Support -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.5</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The guide, the Loom reference and the skill travel inside the jar, so `weave guide` works with no repository (see weave guide). -->
            <resource>
                <directory>../../../docs/guide</directory>
                <targetPath>guide</targetPath>
                <includes><include>*.md</include></includes>
            </resource>
            <resource>
                <directory>.</directory>
                <targetPath>guide</targetPath>
                <includes><include>LOOM_GUIDE.md</include></includes>
            </resource>
            <resource>
                <directory>../../..</directory>
                <targetPath>guide</targetPath>
                <includes><include>llms.txt</include></includes>
            </resource>
            <resource>
                <directory>../../../.claude/skills/llm4j-workflow-guide</directory>
                <targetPath>skill</targetPath>
                <includes><include>SKILL.md</include></includes>
            </resource>
            <!-- the deployer skill: its chapters, its SKILL.md and its launch scripts (the jars it launches are not here: they travel in the skill package) -->
            <resource>
                <directory>../../../docs/deploy</directory>
                <targetPath>deploy</targetPath>
                <includes><include>*.md</include></includes>
            </resource>
            <resource>
                <directory>../../../.claude/skills/llm4j-loom-deployer</directory>
                <targetPath>skill-deployer</targetPath>
                <includes><include>SKILL.md</include><include>scripts/*</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Keeps the engine's per-workflow INFO lines out of the build log; see src/test/resources/logging.properties -->
                        <java.util.logging.config.file>${project.build.testOutputDirectory}/logging.properties</java.util.logging.config.file>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-rules</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>io.github.llm4j.loom.execution.ThreadScope*</include>
                                        <include>io.github.llm4j.loom.execution.InvokerSource</include>
                                        <include>io.github.llm4j.loom.execution.InvokerRefs</include>
                                        <include>io.github.llm4j.loom.tools.OpenApiKind</include>
                                        <include>io.github.llm4j.loom.cli.InvokerOptions*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>io.github.llm4j.loom.context.CompactorRegistry</include>
                                        <include>io.github.llm4j.loom.context.WindowLayers</include>
                                        <include>io.github.llm4j.loom.context.ContextFiles</include>
                                        <include>io.github.llm4j.loom.execution.ContextWiring</include>
                                        <include>io.github.llm4j.loom.execution.ContextSettings</include>
                                        <include>io.github.llm4j.loom.memory.TranscriptAccumulationEngine</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.expr.Interpreter</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.expr.Checker</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.88</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.expr.ExprParser</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.expr.Lexer</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.95</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.ladder.LadderPolicy</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.ladder.LedgerFold</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.ladder.HistoryBuilder</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.ladder.LadderChecks</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.ladder.LadderEngine</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.ladder.LevelLog</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.75</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.runtime.Generations</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.travel.RunTravel</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.travel.OverlayJournal</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.runtime.EffectScan</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.execution.Rewinder</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.AgreementStats</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.Ladder</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.AgentIdentity</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.execution.EvidenceTool</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.execution.Decider</include></includes>
                                    <!-- 0.85 before decisions bound to a ladder moved into LadderDecider: the engine path left in Decider is no longer reached by
                                         trust/ladder decisions, so its lines are no longer exercised. LadderDecider carries the logic and has its own rule below. -->
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.78</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.execution.LadderDecider</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>io.github.llm4j.loom.autonomy</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.channel.Answers</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.channel.Listener</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.channel.PendingStore</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>io.github.llm4j.loom.channel</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>io.github.llm4j.loom.host</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>io.github.llm4j.loom.host.DurabilityGuard</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Copy Dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- The runnable weave jar: every dependency inside, as the cli classifier -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- The library jar (what Maven Central serves) stays small; the runnable weave jar is ai-agent4j-loom-<version>-cli.jar -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>cli</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.llm4j.loom.cli.WeaveCLI</mainClass>
                                    <!-- what the version command prints, so two jars of "the same" version can be told apart -->
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Build-Time>${maven.build.timestamp}</Build-Time>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mutation testing of the ladder language and engine: mvn -Pmutation org.pitest:pitest-maven:mutationCoverage -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.4</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.llm4j.loom.autonomy.expr.*</param>
                                <param>io.github.llm4j.loom.ladder.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.llm4j.loom.autonomy.expr.*Test</param>
                                <param>io.github.llm4j.loom.ladder.*Test</param>
                                <param>io.github.llm4j.loom.parser.Ladder*Test</param>
                                <param>io.github.llm4j.loom.autonomy.LadderRunTest</param>
                                <param>io.github.llm4j.loom.autonomy.LadderStoresTest</param>
                                <param>io.github.llm4j.loom.autonomy.LadderVerificationTest</param>
                            </targetTests>
                            <excludedTests>
                                <param>io.github.llm4j.loom.ladder.LadderAuditTest</param>
                            </excludedTests>
                            <threads>4</threads>
                            <timeoutFactor>3</timeoutFactor>
                            <outputFormats><param>XML</param><param>HTML</param></outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <jvmArgs><jvmArg>-Djava.util.logging.config.file=${project.build.testOutputDirectory}/logging.properties</jvmArg></jvmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Mutation testing of the invoker-credential path: mvn -Pmutation-invoker org.pitest:pitest-maven:mutationCoverage
             (the big classes it touches are judged on the methods that changed: see scripts/pit_survivors.py) -->
        <profile>
            <id>mutation-invoker</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.4</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.llm4j.loom.execution.ThreadScope*</param>
                                <param>io.github.llm4j.loom.execution.InvokerSource</param>
                                <param>io.github.llm4j.loom.execution.InvokerRefs</param>
                                <param>io.github.llm4j.loom.tools.OpenApiKind</param>
                                <param>io.github.llm4j.loom.cli.InvokerOptions*</param>
                                <param>io.github.llm4j.loom.tools.ToolFactory*</param>
                                <param>io.github.llm4j.loom.ast.ToolDef*</param>
                                <param>io.github.llm4j.loom.execution.HarnessExecutor</param>
                                <param>io.github.llm4j.loom.security.SecurityAudit</param>
                                <param>io.github.llm4j.loom.parser.LoomParser</param>
                                <param>io.github.llm4j.loom.autonomy.AgentIdentity</param>
                                <param>io.github.llm4j.loom.cli.WeaveCLI</param>
                                <param>io.github.llm4j.loom.cli.WeaveEnv</param>
                                <param>io.github.llm4j.loom.cli.Runs</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.llm4j.loom.invoker.*Test</param>
                                <param>io.github.llm4j.loom.execution.ThreadScopeTest</param>
                                <param>io.github.llm4j.loom.execution.InvokerSourceTest</param>
                                <param>io.github.llm4j.loom.execution.ConcurrentTopLevelRunsTest</param>
                                <param>io.github.llm4j.loom.execution.CredentialValueTest</param>
                                <param>io.github.llm4j.loom.tools.OpenApiKindTest</param>
                                <param>io.github.llm4j.loom.tools.ToolFactoryInvokerTest</param>
                                <param>io.github.llm4j.loom.cli.InvokerCliTest</param>
