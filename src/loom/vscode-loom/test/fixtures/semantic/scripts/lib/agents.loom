tool Mailer { use: email  outbox: "outbox"  from: "a@example.com"  to: "b@example.com" }
agent Helper { model: "claude-haiku-5-5"  system: "You help." }
agent Scorer { model: "claude-haiku-5-5"  output_schema: { score: number, notes: string, tags: list<string>, choice: string, reasoning: string } }
