{
  "name": "vscode-loom",
  "displayName": "Loom",
  "description": "VS Code extension for Loom DSL (.loom and .loot files). Provides syntax highlighting, LSP diagnostics, workflow outline, a workflow graph, and run command.",
  "version": "1.0.0",
  "publisher": "srijithunni7182",
  "homepage": "https://github.com/srijithunni7182/llm4j/tree/main/src/loom",
  "bugs": {
    "url": "https://github.com/srijithunni7182/llm4j/issues"
  },
  "repository": {
    "url": "https://github.com/srijithunni7182/llm4j"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "loom",
    "llm",
    "ai agents",
    "agents",
    "workflow",
    "dsl",
    "llm4j",
    "weave",
    "eval"
  ],
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "qna": "https://github.com/srijithunni7182/llm4j/issues",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:loom",
    "onLanguage:loot"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "loom",
        "extensions": [
          ".loom"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loot",
        "extensions": [
          ".loot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loom",
        "scopeName": "source.loom",
        "path": "./syntaxes/loom.tmLanguage.json"
      },
      {
        "language": "loot",
        "scopeName": "source.loot",
        "path": "./syntaxes/loot.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loomExplorer",
          "title": "Loom",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "loomExplorer": [
        {
          "id": "loom.workflowOutline",
          "name": "Workflow Outline"
        }
      ]
    },
    "commands": [
      {
        "command": "loom.runWorkflow",
        "title": "Loom: Run Workflow"
      },
      {
        "command": "loom.showGraph",
        "title": "Loom: Show Workflow Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "loom.review",
        "title": "Loom: Review Workflow",
        "icon": "$(checklist)"
      },
      {
        "command": "loom.restartEngine",
        "title": "Loom: Restart Engine"
      },
      {
        "command": "loom.showEngineLog",
        "title": "Loom: Show Engine Log"
      },
      {
        "command": "loom.createPromptFile",
        "title": "Loom: Create Prompt File"
      },
      {
        "command": "loom.openGuide",
        "title": "Loom: Open Guide"
      },
      {
        "command": "loom.installSkill",
        "title": "Loom: Install the Loom Skill in This Project"
      },
      {
        "command": "loom.review.fixAll",
        "title": "Loom: Apply Safe Fixes"
      },
      {
        "command": "loom.review.explain",
        "title": "Loom: Explain Review Rule"
      },
      {
        "command": "loom.review.restore",
        "title": "Loom: Restore Dismissed Findings"
      },
      {
        "command": "loom.review.baseline",
        "title": "Loom: Accept All Existing Findings (Baseline)"
      },
      {
        "command": "loom.review.accept",
        "title": "Loom: Accept a Finding With a Reason"
      },
      {
        "command": "loom.review.dismiss",
        "title": "Loom: Dismiss a Finding"
      },
      {
        "command": "loom.review.fixFinding",
        "title": "Loom: Fix a Finding"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "loom.showGraph",
          "when": "resourceLangId == loom"
        },
        {
          "command": "loom.review",
          "when": "resourceLangId == loom"
        },
        {
          "command": "loom.createPromptFile",
          "when": "resourceLangId == loom"
        },
        {
          "command": "loom.review.fixAll",
          "when": "resourceLangId == loom"
        },
        {
          "command": "loom.review.restore",
          "when": "resourceLangId == loom"
        },
        {
          "command": "loom.review.baseline",
          "when": "resourceLangId == loom"
        },
        {
          "command": "loom.review.accept",
          "when": "false"
        },
        {
          "command": "loom.review.dismiss",
          "when": "false"
        },
        {
          "command": "loom.review.fixFinding",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "loom.review",
          "when": "resourceExtname == .loom",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "loom.review",
          "when": "resourceLangId == loom",
          "group": "navigation"
        },
        {
          "command": "loom.showGraph",
          "when": "resourceLangId == loom",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "loom.review",
          "when": "resourceLangId == loom",
          "group": "navigation"
        },
        {
          "command": "loom.showGraph",
          "when": "resourceLangId == loom",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Loom",
      "properties": {
        "loom.javaPath": {
          "type": "string",
          "default": "java",
          "description": "The java executable used to run the bundled weave.jar (the Loom engine, checks, graphs). If you set only the older loom.graph.javaPath, that one is used."
        },
        "loom.review.on": {
          "type": "string",
          "enum": [
            "save",
            "type",
            "manual"
          ],
          "default": "save",
          "description": "When the Loom review runs by itself: after a save, while typing (only the validity lens, so it stays fast), or only when you ask."
        },
        "loom.review.layout": {
          "type": "string",
          "enum": [
            "split",
            "outline",
            "list"
          ],
          "default": "split",
          "description": "The layout the Review panel opens in: Split (graph and findings side by side), Outline (step by step) or List (a dense table). You can switch in the panel; your last choice is remembered per workspace."
        },
        "loom.review.lenses": {
          "type": "string",
          "default": "",
          "description": "Which review lenses run, as weave review --lens takes them: 'all', exact names (security,cost), or +name / -name to change the defaults. Empty uses the project's review.properties."
        },
        "loom.review.minSeverity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "info"
          ],
          "default": "low",
          "description": "The lowest severity shown as a squiggle and in the Problems panel."
        },
        "loom.review.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show the findings and cost above each workflow, with links to the graph and Run."
        },
        "loom.review.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the open findings and typical cost of the active script in the status bar."
        },
        "loom.review.failOn": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "info",
            "none"
          ],
          "default": "high",
          "description": "Colour the status bar when findings at or above this severity are open. It never stops Run."
        },
        "loom.graph.javaPath": {
          "type": "string",
          "default": "java",
          "description": "The java executable used to run the bundled weave.jar when drawing a workflow graph."
        },
        "loom.graph.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "How long to wait for weave graph before stopping it, in milliseconds. Raise it for very large scripts."
        },
        "loom.graph.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Redraw the workflow graph when the script or a file it imports is saved."
        }
      }
    },
    "snippets": [
      {
        "language": "loom",
        "path": "./snippets/loom.code-snippets"
      }
    ]
  },
  "files": [
    "out/**/*",
    "media/**/*",
    "bin/**/*",
    "syntaxes/**/*",
    "snippets/**/*",
    "language-configuration.json",
    "node_modules/vscode-languageclient/**/*",
    "node_modules/vscode-languageserver/**/*",
    "node_modules/vscode-languageserver-textdocument/**/*",
    "node_modules/vscode-languageserver-protocol/**/*",
    "node_modules/vscode-jsonrpc/**/*",
    "node_modules/vscode-languageserver-types/**/*",
    "node_modules/minimatch/**/*",
    "node_modules/semver/**/*",
    "node_modules/brace-expansion/**/*",
    "node_modules/balanced-match/**/*"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.11"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@types/node": "20.11.0",
    "typescript": "5.3.3",
    "@vscode/test-electron": "2.5.2"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test out-test/test/*.test.js test/*.unit.test.js test/*.browser.test.js",
    "vscode:prepublish": "npm run compile && node -e \"require('fs').accessSync('bin/weave.jar')\" || (echo 'bin/weave.jar is missing: run scripts/build-vsix.sh from the repository root' && exit 1)"
  },
  "icon": "media/loom-mark-128.png"
}
