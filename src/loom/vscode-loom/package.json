{
  "name": "vscode-loom",
  "displayName": "Loom",
  "description": "VS Code extension for Loom DSL (.loom and .loot files). Provides syntax highlighting, LSP diagnostics, workflow outline, a workflow graph, and run command.",
  "version": "1.0.0",
  "publisher": "srijithunni7182",
  "homepage": "https://github.com/srijithunni7182/llm4j/tree/main/src/loom",
  "bugs": {
    "url": "https://github.com/srijithunni7182/llm4j/issues"
  },
  "repository": {
    "url": "https://github.com/srijithunni7182/llm4j"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "loom",
    "llm",
    "ai agents",
    "agents",
    "workflow",
    "dsl",
    "llm4j",
    "weave",
    "eval"
  ],
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "qna": "https://github.com/srijithunni7182/llm4j/issues",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:loom",
    "onLanguage:loot"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "loom",
        "extensions": [
          ".loom"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loot",
        "extensions": [
          ".loot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loom",
        "scopeName": "source.loom",
        "path": "./syntaxes/loom.tmLanguage.json"
      },
      {
        "language": "loot",
        "scopeName": "source.loot",
        "path": "./syntaxes/loot.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loomExplorer",
          "title": "Loom",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "loomExplorer": [
        {
          "id": "loom.workflowOutline",
          "name": "Workflow Outline"
        }
      ]
    },
    "commands": [
      {
        "command": "loom.runWorkflow",
        "title": "Loom: Run Workflow"
      },
      {
        "command": "loom.showGraph",
        "title": "Loom: Show Workflow Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "loom.createPromptFile",
        "title": "Loom: Create Prompt File"
      },
      {
        "command": "loom.openGuide",
        "title": "Loom: Open Guide"
      },
      {
        "command": "loom.installSkill",
        "title": "Loom: Install the Loom Skill in This Project"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "loom.showGraph",
          "when": "resourceLangId == loom"
        },
        {
          "command": "loom.createPromptFile",
          "when": "resourceLangId == loom"
        }
      ],
      "editor/title": [
        {
          "command": "loom.showGraph",
          "when": "resourceLangId == loom",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "loom.showGraph",
          "when": "resourceLangId == loom",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Loom",
      "properties": {
        "loom.graph.javaPath": {
          "type": "string",
          "default": "java",
          "description": "The java executable used to run the bundled weave.jar when drawing a workflow graph."
        },
        "loom.graph.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "How long to wait for weave graph before stopping it, in milliseconds. Raise it for very large scripts."
        },
        "loom.graph.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Redraw the workflow graph when the script or a file it imports is saved."
        }
      }
    },
    "snippets": [
      {
        "language": "loom",
        "path": "./snippets/loom.code-snippets"
      }
    ]
  },
  "files": [
    "out/**/*",
    "media/**/*",
    "bin/**/*",
    "syntaxes/**/*",
    "snippets/**/*",
    "language-configuration.json",
    "node_modules/vscode-languageclient/**/*",
    "node_modules/vscode-languageserver/**/*",
    "node_modules/vscode-languageserver-textdocument/**/*",
    "node_modules/vscode-languageserver-protocol/**/*",
    "node_modules/vscode-jsonrpc/**/*",
    "node_modules/vscode-languageserver-types/**/*",
    "node_modules/minimatch/**/*",
    "node_modules/semver/**/*",
    "node_modules/brace-expansion/**/*",
    "node_modules/balanced-match/**/*"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.11"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@types/node": "20.11.0",
    "typescript": "5.3.3",
    "@vscode/test-electron": "2.5.2"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test out-test/test/*.test.js test/*.browser.test.js",
    "vscode:prepublish": "npm run compile && node -e \"require('fs').accessSync('bin/weave.jar')\" || (echo 'bin/weave.jar is missing: run scripts/build-vsix.sh from the repository root' && exit 1)"
  },
  "icon": "media/loom-mark-128.png"
}
