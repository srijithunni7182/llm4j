<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.srijithunni7182</groupId>
        <artifactId>llm4j-parent</artifactId>
        <version>6.1.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>loom-inspect</artifactId>
    <packaging>jar</packaging>

    <name>Loom Inspect</name>
    <description>Observability add-on for Loom workflows: turns a running workflow's trace into OpenTelemetry-shaped data for the loom-inspect console and server.</description>

    <properties>
        <junit.version>5.10.2</junit.version>
        <jackson.version>2.21.3</jackson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>loom-inspect-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The add-on rides on a Loom runtime that is already on the class path (weave, or the application). -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j-loom</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- The real server, to test the sending side against it end to end. Not a dependency of the add-on itself. -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>loom-fabric</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>loom-inspect</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
