{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srijithunni7182/llm4j/eval4j-report/spec/schema/evaluation.schema.json",
  "title": "eval4j evaluation (one line of evaluations.jsonl)",
  "description": "One judged, asserted, measured or compared evaluation of one case. Appended as it happens, so a crashed run still has everything before the crash.",
  "type": "object",
  "required": ["seq", "key", "metric", "kind", "status"],
  "properties": {
    "seq": { "type": "integer", "minimum": 0, "description": "Monotonic per bundle; orders the lines." },
    "key": { "type": "string", "pattern": "^k_[0-9a-f]{16}$", "description": "Stable across runs: hash of case key, metric id and occurrence index. This is what run comparison matches on." },
    "caseId": { "type": "string", "pattern": "^c_[0-9a-f]{16}$", "description": "Stable id of the case (scenario or test) the evaluation belongs to." },
    "scenarioId": { "type": ["string", "null"], "maxLength": 256 },
    "testId": { "type": ["string", "null"], "maxLength": 512 },
    "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$", "description": "Metric id; resolved through run.json metrics." },
    "kind": { "enum": ["JUDGE", "PAIRWISE", "ASSERTION", "MEASURED"] },
    "status": { "enum": ["EVALUATED", "NOT_EVALUATED", "ERROR"] },
    "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "threshold": { "type": ["number", "null"] },
    "passed": { "type": ["boolean", "null"], "description": "null when status is not EVALUATED." },
    "reason": { "type": ["string", "null"], "maxLength": 20100 },
    "display": { "type": ["string", "null"], "maxLength": 200, "description": "Human text for results that are not a plain score: 'B wins', 'Passed', '3.2 s'." },
    "measured": {
      "type": ["object", "null"],
      "properties": { "value": { "type": "number" }, "unit": { "type": "string" }, "budget": { "type": ["number", "null"] } },
      "required": ["value"],
      "additionalProperties": true
    },
    "family": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$", "description": "Overrides the metric's classification for this evaluation." },
    "facet": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "dimension": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "source": { "enum": ["FRESH", "REUSED", "CARRIED"], "default": "FRESH" },
    "evaluatedInRun": { "type": ["string", "null"], "description": "For CARRIED: the run that produced this result." },
    "evaluatedAt": { "type": ["string", "null"], "format": "date-time" },
    "judgeId": { "type": ["string", "null"] },
    "samples": { "type": ["array", "null"], "items": { "type": "number", "minimum": 0, "maximum": 1 }, "maxItems": 32, "description": "Per-sample scores when the judge ran several samples." },
    "durationMs": { "type": ["integer", "null"], "minimum": 0 },
    "calls": { "type": ["integer", "null"], "minimum": 0 },
    "tokensIn": { "type": ["integer", "null"], "minimum": 0 },
    "tokensOut": { "type": ["integer", "null"], "minimum": 0 },
    "costUsd": { "type": ["number", "null"], "minimum": 0 },
    "input": { "type": ["string", "null"], "maxLength": 20100 },
    "actualOutput": { "type": ["string", "null"], "maxLength": 20100 },
    "expectedOutput": { "type": ["string", "null"], "maxLength": 20100 },
    "retrievalContext": { "type": ["array", "null"], "items": { "type": "string", "maxLength": 20100 }, "maxItems": 50 },
    "traceId": { "type": ["string", "null"], "description": "Refers to a line in traces.jsonl." },
    "timestamp": { "type": "string", "format": "date-time" },
    "attributes": { "type": "object", "description": "Free space. Readers must ignore unknown keys." }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "EVALUATED" } } }, "then": { "required": ["passed"], "properties": { "passed": { "type": "boolean" } } } },
    { "if": { "properties": { "source": { "const": "CARRIED" } }, "required": ["source"] }, "then": { "required": ["evaluatedInRun"] } }
  ],
  "additionalProperties": true
}
