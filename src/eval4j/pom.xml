<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.srijithunni7182</groupId>
        <artifactId>llm4j-parent</artifactId>
        <version>5.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>eval4j</artifactId>
    <packaging>jar</packaging>

    <name>eval4j</name>
    <description>Ground-up evaluation framework for ai-agent4j: AssertJ-style fluent assertions and LLM-as-judge conditions for testing agents, tools, and LLM calls.</description>

    <properties>
        <!-- Versions matched with ai-agent4j -->
        <ai-agent4j.version>${project.version}</ai-agent4j.version>
        <assertj.version>3.27.7</assertj.version>
        <junit.version>6.1.0</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <jackson.version>2.21.3</jackson.version>
    
    </properties>

    <dependencies>
        <!-- Core Library: LLMClient, AgentResult, Tool, LLMRequest/LLMResponse -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j</artifactId>
            <version>${ai-agent4j.version}</version>
        </dependency>

        <!-- AssertJ is a compile-time dependency: custom assertions/conditions are the product -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>

        <!-- YAML golden-dataset loading (io.github.llm4j.eval.dataset) -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- JUnit 5 extension API for EvalReportExtension; also used to write eval4j's own tests.
             `provided`, not the default compile scope: eval4j implements a JUnit5 extension point,
             but consumers bring their own Jupiter version. compile scope would pull Jupiter 6.1.0
             onto every consumer's classpath transitively, which can conflict with a consumer
             pinned to JUnit 5.x. `provided` keeps it available to build eval4j itself (main and
             test) without forcing this version on anyone downstream. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- For exercising EvalReportExtension as a real JUnit 5 extension in-process -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Every package must keep at least 80% of its lines covered by the default tests -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
