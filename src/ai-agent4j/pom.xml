<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.srijithunni7182</groupId>
        <artifactId>llm4j-parent</artifactId>
        <version>6.2.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ai-agent4j</artifactId>
    <packaging>jar</packaging>

    <name>AI Agent4J</name>
    <description>Lightweight LLM library for Java with ReAct agents, RAG, and multi-provider support (Google Gemini, Sarvam AI)</description>

    <properties>
        
        <!-- Dependency Versions -->

        <jackson.version>2.21.7</jackson.version>
        <okhttp.version>5.3.2</okhttp.version>
        <slf4j.version>2.0.12</slf4j.version>
        <junit.version>6.1.0</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <assertj.version>3.27.7</assertj.version>
    
    </properties>

    <dependencies>
        <!-- JSON Processing -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- HTTP Client -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- OpenAPI/Swagger Parser -->
        <dependency>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser</artifactId>
            <version>2.1.19</version>
        </dependency>

        <!-- Vector similarity calculations for RAG -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
            <version>3.6.1</version>
        </dependency>

        <!-- HTML Parsing for search tools -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.2</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${okhttp.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The whole module keeps at least 80% of its lines covered by the default tests (83.9% when this was set) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>io.github.llm4j.secret.InvokerCredentials*</include>
                                        <include>io.github.llm4j.secret.CredentialSource</include>
                                        <include>io.github.llm4j.secret.MissingInvokerCredentialException</include>
                                        <include>io.github.llm4j.agent.tools.openapi.RequestAuth*</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- Context management and compaction (docs/specs/01-context-management): 98.9 % of lines and 89.4 % of branches when this was set -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>io.github.llm4j.context</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- Call-level telemetry (docs/specs/02-call-telemetry) -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>io.github.llm4j.telemetry</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- Classification (docs/specs/07-classifier) -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>io.github.llm4j.classify</include>
                                        <include>io.github.llm4j.provider.typesafe</include>
                                    </includes>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                                        <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mutation testing of the invoker-credential path: mvn -Pmutation-invoker org.pitest:pitest-maven:mutationCoverage -->
        <profile>
            <id>mutation-invoker</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.4</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                            <!-- the plugin was built for JUnit 5; this module runs JUnit 6, so give PIT the same platform -->
                            <dependency>
                                <groupId>org.junit.platform</groupId>
                                <artifactId>junit-platform-launcher</artifactId>
                                <version>${junit.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.junit.platform</groupId>
                                <artifactId>junit-platform-commons</artifactId>
                                <version>${junit.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.llm4j.secret.InvokerCredentials*</param>
                                <param>io.github.llm4j.secret.CredentialSource</param>
                                <param>io.github.llm4j.secret.MissingInvokerCredentialException</param>
                                <param>io.github.llm4j.agent.tools.openapi.RequestAuth*</param>
                                <param>io.github.llm4j.agent.tools.openapi.OpenAPITool*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.llm4j.secret.InvokerCredentialsTest</param>
                                <param>io.github.llm4j.agent.tools.openapi.*Test</param>
                            </targetTests>
                            <threads>4</threads>
                            <timeoutFactor>3</timeoutFactor>
                            <mutationThreshold>85</mutationThreshold>
                            <outputFormats><param>XML</param><param>HTML</param></outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Mutation testing of classification: mvn -Pmutation-classify org.pitest:pitest-maven:mutationCoverage (see docs/specs/07-classifier/VERIFICATION.md) -->
        <profile>
            <id>mutation-classify</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.4</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                            <!-- the plugin was built for JUnit 5; this module runs JUnit 6, so give PIT the same platform -->
                            <dependency>
                                <groupId>org.junit.platform</groupId>
                                <artifactId>junit-platform-launcher</artifactId>
                                <version>${junit.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.junit.platform</groupId>
                                <artifactId>junit-platform-commons</artifactId>
                                <version>${junit.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.llm4j.classify.*</param>
                                <param>io.github.llm4j.provider.typesafe.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.llm4j.classify.*Test</param>
                                <param>io.github.llm4j.provider.typesafe.*Test</param>
                            </targetTests>
                            <threads>4</threads>
                            <timeoutFactor>4</timeoutFactor>
                            <mutationThreshold>75</mutationThreshold>
                            <outputFormats><param>XML</param><param>HTML</param></outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Mutation testing of context management: mvn -Pmutation-context org.pitest:pitest-maven:mutationCoverage (see docs/specs/01-context-management/VERIFICATION.md) -->
        <profile>
            <id>mutation-context</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.4</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                            <!-- the plugin was built for JUnit 5; this module runs JUnit 6, so give PIT the same platform -->
                            <dependency>
                                <groupId>org.junit.platform</groupId>
                                <artifactId>junit-platform-launcher</artifactId>
                                <version>${junit.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.junit.platform</groupId>
                                <artifactId>junit-platform-commons</artifactId>
                                <version>${junit.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.llm4j.context.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.llm4j.context.*Test</param>
                            </targetTests>
                            <threads>4</threads>
                            <timeoutFactor>4</timeoutFactor>
                            <mutationThreshold>80</mutationThreshold>
                            <outputFormats><param>XML</param><param>HTML</param></outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Mutation testing of call telemetry: mvn -Pmutation-telemetry org.pitest:pitest-maven:mutationCoverage (see docs/specs/02-call-telemetry/VERIFICATION.md) -->
        <profile>
            <id>mutation-telemetry</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.4</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                            <!-- the plugin was built for JUnit 5; this module runs JUnit 6, so give PIT the same platform -->
                            <dependency>
                                <groupId>org.junit.platform</groupId>
                                <artifactId>junit-platform-launcher</artifactId>
                                <version>${junit.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.junit.platform</groupId>
                                <artifactId>junit-platform-commons</artifactId>
                                <version>${junit.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.llm4j.telemetry.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.llm4j.telemetry.*Test</param>
                                <param>io.github.llm4j.agent.StatsCollectorTest</param>
                            </targetTests>
                            <threads>4</threads>
                            <timeoutFactor>4</timeoutFactor>
                            <mutationThreshold>80</mutationThreshold>
                            <outputFormats><param>XML</param><param>HTML</param></outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
