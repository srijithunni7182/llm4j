<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.srijithunni7182</groupId>
        <artifactId>ai-agent4j-tools-extras-parent</artifactId>
        <version>6.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ai-agent4j-tools-openapi</artifactId>
    <packaging>jar</packaging>

    <name>AI Agent4J - Tools: openapi</name>
    <description>The openapi tool kind: one tool per operation of an OpenAPI description, called through the shared HTTP layer (address rules, timeouts, size caps, retries that know "never sent" from "may have been"). The specification is read through the same guarded layer; the parser never fetches on its own. Brings swagger-parser.</description>

    <dependencies>
        <dependency>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser</artifactId>
            <version>${swagger-parser.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Mutation testing of what decides things in this module (phase 36, D15): the pin, the cap and the saved file's name,
             the credential, the argument check and the client: mvn -Pmutation-integrations org.pitest:pitest-maven:mutationCoverage -->
        <profile>
            <id>mutation-integrations</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.17.4</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.llm4j.tools.openapi.SpecPin</param>
                                <param>io.github.llm4j.tools.openapi.Answers</param>
                                <param>io.github.llm4j.tools.openapi.Credential</param>
                                <param>io.github.llm4j.tools.openapi.ArgumentCheck</param>
                                <param>io.github.llm4j.tools.openapi.ApiClient</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.llm4j.tools.openapi.*Test</param>
                            </targetTests>
                            <threads>4</threads>
                            <timeoutFactor>4</timeoutFactor>
                            <mutationThreshold>85</mutationThreshold>
                            <outputFormats><param>XML</param><param>HTML</param></outputFormats>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
