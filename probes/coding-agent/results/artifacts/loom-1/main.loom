// main.loom
audit { logger: "file" path: "logs/audit.json" }

routing CustomerSupportLogic {
    strategy: fallback
    primary: "gpt-4o" // Placeholder for the primary model
    fallback: ["gemini-1.5-flash"] // Placeholder for a fallback model
}

agent SupportAgent {
    model: "gpt-4o" // Placeholder for the model that drafts replies
    system: "Draft a professional reply to the customer's question."
    guard { pii: mask  bias: warn } // Guard against PII and bias
}

tool Notify {
    use: webhook
    url: env.SLACK_WEBHOOK
    format: json
}

knowledge CompanyPolicies {
    source: "policies/"
    embedding: "gemini/text-embedding-004"
    top_k: 4
    store: "index/company_policies.json"
}

policy NoRefunds {
    source: "policies/no_refunds.md"
    embedding: "gemini/text-embedding-004"
}

workflow Main(question) {
    observe "Customer Question Received" {question}

    // Draft a reply to the customer's question
    delegate "Draft Reply: {question}" to SupportAgent -> response

    // Check the response against company policies
    check response against NoRefunds using Compliance -> verdict on_violation {
        fail "Policy Violation: Response contains a promise of refund or compensation."
    }

    // Post the approved response to the Slack channel
    use Notify(text = response) approve "Post this reply to the channel?" -> receipt
}