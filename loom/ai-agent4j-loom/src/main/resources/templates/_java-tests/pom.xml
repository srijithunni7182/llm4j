<?xml version="1.0" encoding="UTF-8"?>
<!--
    {{name}}: a Loom workflow project.
      src/main/resources            the workflow (main.loom) and its prompts: they travel with the program
      src/test/resources/eval/golden  the golden dataset (example requests and what a good answer does)
      src/test/java                 eval4j JUnit tests: each golden scenario is its own test case, on a model that costs nothing
    `weave` reads the same files, so `weave check`, `weave eval` and `mvn test` always agree.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>example</groupId>
    <artifactId>{{artifact}}</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- Loom, with the dataset and evaluation classes the tests use. Your own Java code (tasks, tools, a screen) goes in src/main/java and uses it too. -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j-loom</artifactId>
            <version>5.0</version>
        </dependency>
        <!-- With this on the test classpath, `mvn test` also writes the eval4j dashboard: target/eval4j/report/index.html -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>eval4j-report</artifactId>
            <version>5.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- 3.x runs JUnit 5. An old surefire finds no JUnit 5 tests and reports success: the next line makes that a failure. -->
                <version>3.2.5</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
