// The new-feature examples from README.md and LOOM_GUIDE.md. DocumentedExamplesTest keeps them parseable.
budget { tokens: 200000  calls: 150  warn_at: 80% }
agent Lead { model: "m" }
agent Writer {
    model: "gemini/gemini-2.5-flash"
    temperature: 0.9
    budget { tokens: 20000  per_call: 2000 }
}
agent Critic { model: "m" }
agent CheapWriter { model: "m" }
agent Supervisor { model: "m" }
agent Showrunner { model: "m" }
workflow Main(doc) {
    loop until (review.verdict == "COMPLETE") max 5 {
        delegate "Review round {_loopRound}" to Lead -> review
        for each fix in review.fixes { delegate "{fix.task}" to {fix.owner} -> {fix.output} }
    } on_exhausted {
        note "Shipping with open issues after {_loopRounds} rounds"
    }
    delegate "Summarise {doc}" to Writer -> summary retry 2 backoff 2s timeout 90s
        on_failure { handoff "Writer unavailable: {_error}" to Supervisor }
    delegate "Review the build" to Showrunner -> review expecting {
        verdict: enum["COMPLETE", "INCOMPLETE"],
        fixes: list
    }
    parallel for each shot in review.fixes {
        delegate "Shoot {shot.description}" to Lead -> {shot.name}
    }
    // Cost budgets (README + LOOM_GUIDE "Cost Budgets")
    delegate "Draft {topic}" to Writer -> draft budget 5000 tokens
        on_failure { note "Out of budget: {_error}" }
    loop until (critique.verdict == "OK") max 5 budget 30000 tokens {
        delegate "Review {draft}" to Critic -> critique
    } on_exhausted {
        note "Stopped by {_loopExhaustedBy} after {_loopRounds} rounds"
    }
    alt (_budget.remaining < 20000) {
        delegate "Polish {draft}" to CheapWriter -> final
    } else {
        delegate "Polish {draft}" to Writer -> final
    }
}
