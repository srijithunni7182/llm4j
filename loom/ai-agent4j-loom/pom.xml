<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.srijithunni7182</groupId>
    <artifactId>ai-agent4j-loom</artifactId>
    <version>5.0</version>
    <packaging>jar</packaging>

    <name>AI Agent4J Loom</name>
    <description>Lexer, Parser, and Compiler for the Loom Agent Orchestration DSL.</description>

    <properties>
        <!-- Tests tagged "live" call real provider APIs: never in a default build (run with -Plive). -->
        <live.groups></live.groups>
        <live.excluded>live</live.excluded>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- Core ai-agent4j dependency -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j</artifactId>
            <version>5.0</version>
        </dependency>

        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j-addons</artifactId>
            <version>5.0</version>
        </dependency>

        <!-- The tools a script can declare: webhook, email, http, file, shell, sql -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j-tools</artifactId>
            <version>5.0</version>
        </dependency>
        <!-- Its test helpers (echo server, scripted SMTP server, recording context) -->
        <dependency>
            <groupId>io.github.srijithunni7182</groupId>
            <artifactId>ai-agent4j-tools</artifactId>
            <version>5.0</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- JSON Processing (Jackson) from Core -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>5.3.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
        <!-- Tests the JDBC run journal against a real SQL database. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>

        <!-- SMTP for the `email` tool; optional in ai-agent4j-tools, so the CLI brings it. Only loaded when a script uses it. -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <version>2.0.3</version>
        </dependency>
        <!-- A real SMTP server for testing the `email` tool kind -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>2.1.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Contract test: the graph JSON is validated against its published schema -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>1.5.6</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.16</version>
            <scope>test</scope>
        </dependency>

        <!-- CLI Support -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.5</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <groups>${live.groups}</groups>
                    <excludedGroups>${live.excluded}</excludedGroups>
                    <systemPropertyVariables>
                        <user.language>en</user.language>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-rules</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.runtime.Generations</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.travel.RunTravel</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.travel.OverlayJournal</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.runtime.EffectScan</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.execution.Rewinder</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.AgreementStats</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.Ladder</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.autonomy.AgentIdentity</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.execution.EvidenceTool</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.execution.Decider</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>io.github.llm4j.loom.autonomy</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.channel.Answers</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.channel.Listener</include></includes>
                                    <limits><limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>io.github.llm4j.loom.channel.PendingStore</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes><include>io.github.llm4j.loom.channel</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            
            <!-- Copy Dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Shade Plugin for Fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.llm4j.loom.cli.WeaveCLI</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- mvn -Plive verify: the live suite against real APIs, for whichever keys are set -->
            <id>live</id>
            <properties>
                <live.groups>live</live.groups>
                <live.excluded></live.excluded>
            </properties>
        </profile>
    </profiles>
</project>
